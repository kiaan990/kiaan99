generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Semester {
  id        String              @id @default(cuid())
  name      String              // e.g. "Fall 2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean             @default(false)
  breaks    SemesterBreak[]
  courses   BrightspaceCourse[]
  createdAt DateTime            @default(now())
}

model SemesterBreak {
  id         String   @id @default(cuid())
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  name       String
  startDate  DateTime
  endDate    DateTime
}

model OAuthToken {
  id           String   @id @default(cuid())
  provider     String   @unique // "gmail" | "outlook"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("medium") // high | medium | low
  dueDate     DateTime?
  tags        String    @default("[]") // JSON array stored as string
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GpaCourse {
  id          String   @id @default(cuid())
  name        String
  courseCode  String?
  credits     Float
  letterGrade String   // A, A-, B+, B, B-, C+, C, C-, D+, D, D-, F
  semester    String   // e.g. "Spring 2026"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GoodNotesLink {
  id          String   @id @default(cuid())
  name        String
  description String?
  url         String   // goodnotes5:// deep link or https URL
  emoji       String   @default("📓")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model BrightspaceCourse {
  id          String                  @id @default(cuid())
  name        String
  courseCode  String?
  color       String                  @default("#f59e0b")
  semesterId  String?
  semester    Semester?               @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  assignments BrightspaceAssignment[]
  grades      BrightspaceGrade[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model BrightspaceAssignment {
  id        String            @id @default(cuid())
  courseId  String
  course    BrightspaceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  submitted Boolean           @default(false)
  grade     Float?
  maxGrade  Float?
  weight    Float?
  status    String            @default("pending") // pending | submitted | graded | missing
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model BrightspaceGrade {
  id        String            @id @default(cuid())
  courseId  String
  course    BrightspaceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category  String
  earned    Float?
  possible  Float?
  weight    Float?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}
