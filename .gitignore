# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Local environment — never commit
.env.local
dev.db
*.db-journal
*.db-shm
*.db-wal

# Playwright browser cache
/playwright-report/
/test-results/

# volt
volt/.env
volt/volt.db*
volt/.browser_profiles/
volt/.cache/
volt/debug/
volt/raw/
volt/exports/
volt/logs/
volt/.venv/
volt/**/__pycache__/
volt/.pytest_cache/
volt/.mypy_cache/
volt/.ruff_cache/
