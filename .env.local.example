# ─────────────────────────────────────────────
# COMMAND CENTER — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# App base URL (required for OAuth redirects)
NEXTAUTH_URL=http://localhost:3000

# ── iCloud Calendar (CalDAV) ──────────────────
# Your Apple ID email address
APPLE_ID=you@icloud.com
# App-specific password generated at appleid.apple.com
# Go to: Sign-In & Security → App-Specific Passwords → Generate
APPLE_APP_PASS=xxxx-xxxx-xxxx-xxxx

# ── Outlook / Microsoft Graph ─────────────────
# Register at: portal.azure.com → Azure Active Directory → App Registrations
# Redirect URI to add: http://localhost:3000/api/email/outlook?action=callback
MICROSOFT_CLIENT_ID=your-azure-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
# Use "common" for personal Microsoft accounts, or your tenant ID for Bentley
MICROSOFT_TENANT_ID=common

# ── Gmail / Google OAuth ──────────────────────
# Register at: console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API
# OAuth redirect URI to add: http://localhost:3000/api/email/gmail?action=callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Brightspace (D2L) Scraper ─────────────────
# Your Bentley University login credentials (stored locally only, never sent anywhere)
# IMPORTANT: Review Bentley's Acceptable Use Policy before enabling the scraper.
BRIGHTSPACE_USER=jsmith1
BRIGHTSPACE_PASS=your-bentley-password
