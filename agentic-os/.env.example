# Agentic OS settings. install.sh fills this in for you as .env (never commit .env).

# Port for the dashboard. The app ALWAYS listens on 127.0.0.1 only (this Mac).
PORT=4777

# Generated by install.sh. Stops other websites from calling the local API through your browser.
LOCAL_TOKEN=

# Absolute path to your Obsidian vault ("second brain").
VAULT_PATH=

# --- Optional: OpenAI (voice + quick chat). Leave empty to keep them disabled. ---
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# TIER2_PROVIDER=openai        # set to "none" to turn quick chat off even with a key
# TIER2_MODEL=gpt-4o-mini
# VOICE_IDLE_SECONDS=60        # voice hangs up after this much silence
# VOICE_MAX_MINUTES=15         # and after this long in total

# --- Claude Code runs (use your Claude login/subscription) ---
# CLAUDE_BIN=claude
# CLAUDE_MAX_TURNS=40          # upper cap per run; each skill may set lower
# CLAUDE_MAX_MINUTES=20        # upper cap per run
# CLAUDE_MODEL=                # empty = Claude Code's default
# CLAUDE_ALLOW_API_KEY=false   # true = let runs use ANTHROPIC_API_KEY (metered) instead of your login

# --- Optional, off by default: READ-ONLY connector to your personal server's MCP endpoint ---
# MCP_SERVER_URL=
# MCP_AUTH_TOKEN=
# MCP_READ_TOOLS=calendar_events,tasks_list,brief_list,brief_get

# --- Cloud mode (your own server, private via Tailscale) — filled in by deploy/setup-server.sh ---
# PUBLIC_ORIGIN=https://kiaan-cloud.your-tailnet.ts.net:8443   # the address Tailscale Serve gives you
# TAILSCALE_ALLOWED_USERS=you@example.com                     # only these Tailscale logins get in (required with PUBLIC_ORIGIN)
# CLAUDE_CODE_OAUTH_TOKEN=                                     # from `claude setup-token` (your subscription, not an API key)
# VAULT_GIT_SYNC=true                                          # pull before jobs / push new notes to your private vault repo
# VAULT_GIT_PULL_MINUTES=5
